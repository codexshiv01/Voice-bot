# ============================================
# Vapi.ai Voice Agent - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# copy .env.example .env

# ------ REQUIRED ------

# Your Vapi.ai Private API Key
# Get it from: https://dashboard.vapi.ai → Settings → API Keys
VAPI_API_KEY=your_vapi_api_key_here

# Your Vapi phone number ID (the one you already bought)
# Get it from: https://dashboard.vapi.ai → Phone Numbers → click your number → copy the ID
VAPI_PHONE_NUMBER_ID=your_phone_number_id_here

# ------ EMAIL NOTIFICATIONS (for appointment booking) ------

# Your Gmail address (used to SEND emails)
EMAIL_USER=shivanshagrawal831@gmail.com

# Gmail App Password (NOT your regular Gmail password!)
# How to get it:
#   1. Go to https://myaccount.google.com/apppasswords
#   2. You MUST have 2-Step Verification enabled first
#   3. Create a new app password for "Mail"
#   4. Copy the 16-character password (like: abcd efgh ijkl mnop)
#   5. Paste it below WITHOUT spaces
EMAIL_APP_PASSWORD=your_gmail_app_password_here

# Your name and email (for the booking notification)
YOUR_NAME=Shivansh Agrawal
YOUR_EMAIL=shivanshagrawal831@gmail.com

# ------ BOOKING SERVER ------

# Port for the booking webhook server (default: 3000)
PORT=3000

# Your public URL where the booking server is accessible
# Use ngrok for local dev: ngrok http 3000 → copy the https URL
# Example: https://abc123.ngrok-free.app
PUBLIC_SERVER_URL=https://your-ngrok-url.ngrok-free.app
